{
  "compilerOptions": {
    // ES2021 so TC39 decorators (@callable) are transformed, as the Agents SDK requires.
    "target": "es2021",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["./worker-configuration.d.ts", "vite/client", "node", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "worker-configuration.d.ts", "vite.config.ts", "vitest.config.ts"]
}
