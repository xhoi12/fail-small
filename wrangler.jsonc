{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fail-small",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"], // required by the Agents SDK

  // The game UI: a React app built by Vite. Requests for /agents/* and /api/* go to
  // the Worker first; everything else is a static asset (or index.html, for the SPA).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },

  // Llama 3.3 on Workers AI powers the co-pilot. Models run on Cloudflare's GPUs, so in
  // local dev this binding is always remote (npm start only enables it when you're logged in).
  "ai": { "binding": "AI", "remote": true },

  // One GameSession agent (Agents SDK, backed by a Durable Object) per player:
  // fleet state, chat memory, scores. Routed at /agents/game-session/<player-id>.
  "durable_objects": {
    "bindings": [{ "name": "GameSession", "class_name": "GameSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameSession"] }],

  // Every rollout is a durable Workflow instance: apply stage -> bake -> health gate -> decide.
  "workflows": [
    { "name": "fail-small-rollout", "binding": "ROLLOUT_WORKFLOW", "class_name": "RolloutWorkflow" }
  ],

  "vars": { "COPILOT_MODE": "auto" },
  "observability": { "enabled": true }
}
